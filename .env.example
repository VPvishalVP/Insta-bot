# ===================================
# Instagram Bot Configuration
# ===================================

# Your Instagram Account Credentials
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Bot Identity & Persona
BOT_NAME=AAIRA
OWNER_NAME=Vishal

# AI Auto-Reply (Groq SDK)
ENABLE_AI=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Polling Interval (in milliseconds, 15000 = 15 seconds)
POLL_INTERVAL=15000

# Optional Web Status Port
PORT=3005
